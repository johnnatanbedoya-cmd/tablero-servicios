# Acceso al tablero
TABLERO_PASSWORD=""
SESSION_SECRET=""          # texto aleatorio largo (ej. openssl rand -hex 32)
TABLERO_URL=""             # ej. https://tablero-servicios.vercel.app (para el enlace del correo)

# Lecturas automáticas (tokens de solo lectura)
NEON_API_KEY=""            # Neon > Account settings > API keys (varias separadas por coma si hay más de una cuenta)
NETLIFY_TOKEN=""           # Netlify > User settings > Applications > Personal access tokens
TOKEN_VERCEL=""            # Vercel > Account settings > Tokens
GITHUB_TOKEN=""            # GitHub fine-grained token con permiso de cuenta "Plan: read"
ANTHROPIC_ADMIN_KEY=""     # opcional: solo si tu cuenta de Anthropic es organización
ANTHROPIC_PRESUPUESTO_USD="" # tope mensual para el semáforo de Anthropic

# Alertas por correo (solo cuando algo está en rojo)
CRON_SECRET=""             # texto aleatorio; Vercel lo envía solo al cron
RESEND_API_KEY=""          # clave con acceso completo (para leer el historial y no repetir avisos)
ALERTA_DE="Tablero <alertas@rpcolomiba.com>"
ALERTA_PARA="johnnatan.bedoya@gmail.com"
